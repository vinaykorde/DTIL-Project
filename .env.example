# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-Side Admin Key (Optional for Local Dev, Required for instant auto-confirmed student accounts)
# SECURITY NOTE: Never prefix with VITE_ so it remains strictly in Node.js server memory and is never bundled in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
